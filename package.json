{
  "name": "warplot",
  "version": "0.1.0",
  "private": true,
  "description": "Smart war board / constraint checker for designing battle scenes in fiction",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run tests/golden",
    "golden:update": "vitest run tests/golden -u",
    "coverage": "vitest run --coverage --coverage.include=src/**"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
